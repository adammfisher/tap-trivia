# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :tvos, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'TapTrivia-tvOS' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
    # Xcode 26 Clang enforces stricter consteval rules that break fmt 11.x.
    # fmt's base.h auto-detects and unconditionally defines FMT_USE_CONSTEVAL=1,
    # ignoring CLI flags. Patch the header to force it off before the #if block.
    fmt_base_h = "#{installer.pods_project.path.dirname}/fmt/include/fmt/base.h"
    if File.exist?(fmt_base_h)
      content = File.read(fmt_base_h)
      unless content.include?('// xcode26-consteval-fix')
        content = content.gsub(
          '#if FMT_USE_CONSTEVAL',
          "// xcode26-consteval-fix: override detection; consteval is broken in Xcode 26\n#undef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n#if FMT_USE_CONSTEVAL"
        )
        File.write(fmt_base_h, content)
        Pod::UI.puts '[fmt] Patched FMT_USE_CONSTEVAL=0 for Xcode 26 compatibility'
      end
    end
  end
end
