{
  "name": "@amazon-devices/taptriviatv",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules buildinfo.json dist build",
    "start": "react-native start",
    "build:release": "react-native build-vega --build-type Release",
    "build:debug": "react-native build-vega --build-type Debug",
    "build": "npm run build:release",
    "run:vvd": "vega run-app build/aarch64-release/*.vpkg tv.taptrivia.firestick.main -d VirtualDevice",
    "run:device": "vega device install-app --packagePath build/armv7-release/*.vpkg && vega device launch-app --appName tv.taptrivia.firestick.main"
  },
  "dependencies": {
    "@amazon-devices/kepler-media-controls": "^1.0.17",
    "@amazon-devices/react-native-kepler": "^2.0.1758683737",
    "@amazon-devices/react-native-w3cmedia": "^2.2.20",
    "@amazon-devices/webview": "^3.3.0",
    "react": "18.2.0",
    "react-native": "0.72.0"
  },
  "devDependencies": {
    "@amazon-devices/kepler-cli-platform": "^0",
    "@react-native-community/cli": "11.3.2",
    "@react-native/metro-config": "^0.72.6",
    "@tsconfig/react-native": "^3.0.2",
    "@types/react": "^18.0.24",
    "metro-react-native-babel-preset": "^0.76.5",
    "typescript": "4.8.4"
  },
  "kepler": {
    "projectType": "application",
    "appName": "TapTriviaTV",
    "targets": [
      "tv"
    ]
  }
}
