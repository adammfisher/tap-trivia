<?xml version="1.0" encoding="utf-8" ?>
<component name="LeaderRow" extends="Group">
  <interface>
    <field id="playerData" type="assocarray" onChange="onDataChanged" />
    <field id="playerRank" type="integer" value="0" onChange="onRankChanged" />
    <field id="compact" type="boolean" value="false" />
  </interface>

  <children>
    <!-- Glass background row (pre-rendered rounded PNG) -->
    <Poster id="rowBg" uri="pkg:/images/leader-row-bg.png" width="860" height="68" />

    <!-- Rank number -->
    <Label id="rankLabel" text=""
           translation="[16, 18]" width="36" color="#ffffff40">
      <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="26" />
    </Label>

    <!-- Player avatar -->
    <Avatar id="playerAvatar" translation="[56, 10]" />

    <!-- Player name -->
    <Label id="nameLabel" text=""
           translation="[116, 20]" width="560" color="#ffffffB0">
      <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="26" />
    </Label>

    <!-- Score -->
    <Label id="scoreLabel" text=""
           translation="[750, 20]" horizAlign="right" width="100" color="#ffd200">
      <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="26" />
    </Label>
  </children>

  <script type="text/brightscript" uri="pkg:/components/utils/Utils.brs" />
  <script type="text/brightscript" uri="LeaderRow.brs" />
</component>
