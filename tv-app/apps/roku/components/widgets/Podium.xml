<?xml version="1.0" encoding="utf-8" ?>
<component name="Podium" extends="Group">
  <interface>
    <field id="scores" type="array" value="[]" onChange="onScoresChanged" />
    <field id="showScore" type="boolean" value="true" onChange="onShowScoreChanged" />
    <field id="soloMode" type="boolean" value="false" onChange="onSoloModeChanged" />
  </interface>

  <children>
    <!-- Podium layout: 2nd (left) | 1st (center, tallest) | 3rd (right) -->
    <!-- Total width: ~760px, centered -->

    <!-- 2nd Place (left, bar 200w centered at x=100 within group) -->
    <Group id="place2" translation="[0, 40]">
      <Avatar id="avatar2" translation="[64, 0]" />
      <Label id="name2" text="" translation="[0, 110]" horizAlign="center" width="200" color="#ffffffB0">
        <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="22" />
      </Label>
      <Label id="score2" text="" translation="[0, 136]" horizAlign="center" width="200" color="#ffd200">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="26" />
      </Label>
      <!-- Podium bar (pre-rendered gradient PNG) -->
      <Poster id="bar2" uri="pkg:/images/podium-bar-silver.png" width="200" height="100" translation="[0, 170]" />
      <Label id="rank2Num" text="2" translation="[0, 195]" horizAlign="center" width="200" color="#ffffff40">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="48" />
      </Label>
    </Group>

    <!-- 1st Place (center, tallest, bar 280w centered at x=140 within group) -->
    <Group id="place1" translation="[240, 0]">
      <Avatar id="avatar1" translation="[92, 0]" />
      <Label id="name1" text="" translation="[0, 140]" horizAlign="center" width="280" color="#f0f0f0">
        <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="26" />
      </Label>
      <Label id="score1" text="" translation="[0, 170]" horizAlign="center" width="280" color="#ffd200">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="32" />
      </Label>
      <!-- Podium bar (tallest, pre-rendered gradient PNG) -->
      <Poster id="bar1" uri="pkg:/images/podium-bar-gold.png" width="280" height="140" translation="[0, 210]" />
      <Label id="rank1Num" text="1" translation="[0, 240]" horizAlign="center" width="280" color="#08080c40">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="56" />
      </Label>
    </Group>

    <!-- 3rd Place (right, bar 200w centered at x=100 within group) -->
    <Group id="place3" translation="[560, 60]">
      <Avatar id="avatar3" translation="[64, 0]" />
      <Label id="name3" text="" translation="[0, 100]" horizAlign="center" width="200" color="#ffffffB0">
        <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="22" />
      </Label>
      <Label id="score3" text="" translation="[0, 126]" horizAlign="center" width="200" color="#ffd200">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="26" />
      </Label>
      <!-- Podium bar (pre-rendered gradient PNG) -->
      <Poster id="bar3" uri="pkg:/images/podium-bar-bronze.png" width="200" height="80" translation="[0, 160]" />
      <Label id="rank3Num" text="3" translation="[0, 180]" horizAlign="center" width="200" color="#ffffff40">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="44" />
      </Label>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/components/utils/Utils.brs" />
  <script type="text/brightscript" uri="Podium.brs" />
</component>
