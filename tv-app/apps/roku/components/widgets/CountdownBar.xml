<?xml version="1.0" encoding="utf-8" ?>
<component name="CountdownBar" extends="Group">
  <interface>
    <field id="nextGameEpoch" type="longinteger" value="0" onChange="onEpochChanged" />
  </interface>

  <children>
    <!-- Semi-transparent glass bar at top center -->
    <Rectangle id="barBg" translation="[660, 16]" width="600" height="52"
               color="#0f0326" opacity="0.6" />

    <!-- Label: "Next Game In" -->
    <Label id="preLabel" text="Next Game In" translation="[660, 20]"
           width="320" horizAlign="right" color="#ffffff80">
      <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="24" />
    </Label>

    <!-- Countdown value -->
    <Label id="valueLabel" text="" translation="[990, 18]"
           width="260" horizAlign="left" color="#ffd200">
      <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="28" />
    </Label>
  </children>

  <script type="text/brightscript" uri="pkg:/components/utils/FontFix.brs" />
  <script type="text/brightscript" uri="CountdownBar.brs" />
</component>
