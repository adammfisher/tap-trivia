<?xml version="1.0" encoding="utf-8" ?>
<!--
  QRBadgeGame — in-game (question-screen) QR badge. Matches web tv-app
  qrBadgeHTML('bl') exactly (1.2x scale baked into 1920-native px):
  dark glass card, white QR card, "Join Trivia! / Play free for 7 days /
  scan to start / app.taptrivia.tv / JOIN {code}". Anchored bottom-left.
-->
<component name="QRBadgeGame" extends="Group">
  <interface>
    <field id="barCode" type="string" value="" onChange="onBarCodeChanged" />
  </interface>

  <children>
    <Poster id="badgeBg" uri="pkg:/images/qrbadge-game-bg.png" width="600" height="270" />

    <!-- White QR card + QR -->
    <Poster id="qrCard" translation="[20, 20]" width="230" height="230" uri="pkg:/images/qrbadge-card.png" />
    <Poster id="qrImage" translation="[35, 35]" width="200" height="200" uri="pkg:/images/qr-play-200.png" />

    <!-- Info column -->
    <Label id="titleLabel" text="Join Trivia!" translation="[280, 49]" color="#f0f0f0">
      <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="38" />
    </Label>
    <Label id="offerLabel" text="Play free for 7 days" translation="[280, 92]" color="#00d4aa">
      <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="26" />
    </Label>
    <Label id="scanLabel" text="SCAN TO START" translation="[280, 121]" color="#ffffff73">
      <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="19" />
    </Label>
    <Label id="urlLabel" text="app.taptrivia.tv" translation="[280, 148]" color="#ffd200">
      <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="26" />
    </Label>
    <Label id="joinLabel" text="JOIN" translation="[280, 192]" color="#ffffff66">
      <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="22" />
    </Label>
    <Label id="codeLabel" text="" translation="[340, 186]" color="#ffd200">
      <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="34" />
    </Label>
  </children>

  <script type="text/brightscript" uri="pkg:/components/utils/FontFix.brs" />
  <script type="text/brightscript" uri="QRBadgeGame.brs" />
</component>
