<?xml version="1.0" encoding="utf-8" ?>
<component name="BetweenScreen" extends="Group">
  <interface>
    <field id="barCode" type="string" />
    <field id="barName" type="string" />
    <field id="signageSlides" type="array" value="[]" />
    <field id="signageIndex" type="integer" value="0" onChange="onSignageIndexChanged" />
    <field id="barLogoUrl" type="string" value="" />
    <field id="gameState" type="assocarray" onChange="onGameStateChanged" />
  </interface>

  <children>
    <!-- Background gradient -->
    <Poster id="bgGradient" width="1920" height="1080"
            uri="pkg:/images/bg-gradient.png" />

    <!-- Dark panel behind right/signage half -->
    <Rectangle id="rightPanelBg" translation="[960, 0]" width="960" height="1080" color="#000000" opacity="0.2" />

    <!-- ═══ LEFT COLUMN (960px): Fun fact + standings ═══ -->

    <Group id="leftCol" translation="[0, 0]">

      <!-- Fun fact card (glass morphism background) — TOP of left column -->
      <Rectangle id="funFactBg" translation="[30, 30]" width="900" height="200"
                 color="#FFFFFF" opacity="0.08" cornerRadius="20" visible="false" />
      <Label id="funFactLabel" text="DID YOU KNOW?" translation="[30, 48]"
             width="900" horizAlign="center" color="#ffd200" visible="false">
        <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="20" />
      </Label>
      <Label id="funFactText" text="" translation="[60, 82]"
             width="840" horizAlign="center" wrap="true" maxLines="4"
             color="#f0f0f0" visible="false">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="32" />
      </Label>

      <!-- Logo (md, 48px) — centered in 960px -->
      <Logo id="logo" translation="[374, 160]" />

      <!-- Bar name — centered -->
      <Label id="barNameLabel" text="" translation="[0, 226]" color="#f0f0f0"
             width="960" horizAlign="center">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="32" />
      </Label>

      <!-- "Standings" heading — centered -->
      <Label id="standingsLabel" text="Standings"
             translation="[0, 270]" color="#ffffff80" width="960" horizAlign="center">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="34" />
      </Label>

      <!-- 5 standings rows (860px wide, centered in 960px → X=50) -->
      <Group id="standingsList" translation="[50, 320]">
        <LeaderRow id="standing1" translation="[0, 0]" />
        <LeaderRow id="standing2" translation="[0, 80]" />
        <LeaderRow id="standing3" translation="[0, 160]" />
        <LeaderRow id="standing4" translation="[0, 240]" />
        <LeaderRow id="standing5" translation="[0, 320]" />
      </Group>

      <!-- Countdown label — centered (Y positioned dynamically in BRS) -->
      <Label id="countdownLabel" text=""
             translation="[0, 740]" color="#ffffff40" width="960" horizAlign="center">
        <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
      </Label>
    </Group>

    <!-- QR Badge — bottom-center of left half (shown when no signage) -->
    <QRBadge id="qrBadge" translation="[300, 940]" visible="false" />

    <!-- ═══ RIGHT HALF: Signage panel ═══ -->
    <SignagePanel id="signagePanel" translation="[960, 0]" visible="false" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/utils/FontFix.brs" />
  <script type="text/brightscript" uri="pkg:/components/utils/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/utils/Colors.brs" />
  <script type="text/brightscript" uri="BetweenScreen.brs" />
</component>
