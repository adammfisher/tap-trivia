<?xml version="1.0" encoding="utf-8" ?>
<component name="LobbyScreen" extends="Group">
  <interface>
    <field id="barCode" type="string" value="" />
    <field id="barName" type="string" value="" />
    <field id="signageSlides" type="array" value="[]" />
    <field id="signageIndex" type="integer" value="0" onChange="onSignageIndexChanged" />
    <field id="barLogoUrl" type="string" value="" />
    <field id="gameState" type="assocarray" onChange="onGameStateChanged" />
  </interface>

  <children>
    <!-- Background gradient -->

    <!-- ══════════════════════════════════════════════════════
         COUNTDOWN — top-left when signage, top-center otherwise
         ══════════════════════════════════════════════════════ -->
    <Group id="countdownGroup" translation="[960, 24]">
      <Label id="countdownLabel" text="NEXT GAME IN"
             color="#ffffff66">
        <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="26" />
      </Label>
      <Label id="countdownValue" text=""
             translation="[0, 32]" color="#ffd200">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="64" />
      </Label>
    </Group>

    <!-- ══════════════════════════════════════════════════════
         LEFT COLUMN — Logo, bar name, QR, bar code
         Centered within left 960px half (padding 80px each side)
         ══════════════════════════════════════════════════════ -->
    <Group id="leftColumn" translation="[0, 80]">
      <!-- TapTrivia Logo (centered in 960px left half) -->
      <Logo id="logo" translation="[300, 0]" />

      <!-- Bar name (centered, Fredoka Bold 56px) -->
      <Label id="lobbyBarName" text="" translation="[80, 130]" color="#f0f0f0"
             width="800" horizAlign="center">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="56" />
      </Label>

      <!-- Subtitle (centered) -->
      <Label text="Scan to join or enter code below"
             translation="[80, 200]" color="#ffffff66"
             width="800" horizAlign="center">
        <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="30" />
      </Label>

      <!-- QR Code (360px, centered in 960px: (960-360)/2 = 300) -->
      <Group id="qrGroup" translation="[300, 290]">
        <Rectangle id="qrBg" color="#ffffff" width="360" height="360" />
        <Poster id="qrPoster" translation="[20, 20]" width="320" height="320"
                uri="pkg:/images/qr-play-360.png" />
      </Group>

      <!-- Bar code display section (centered) -->
      <Group id="codeSection" translation="[80, 698]">
        <Label text="OR ENTER CODE" color="#ffffff66"
               horizAlign="center" width="800">
          <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="22" />
        </Label>

        <!-- Bar code display: large gold Fredoka (matches web 112px) -->
        <Label id="lobbyBarCode" text=""
               translation="[0, 36]" color="#ffd200"
               horizAlign="center" width="800">
          <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="112" />
        </Label>

        <!-- URL -->
        <Label text="app.taptrivia.tv"
               translation="[0, 172]" color="#ffffff4D"
               horizAlign="center" width="800">
          <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="26" />
        </Label>
      </Group>
    </Group>

    <!-- ══════════════════════════════════════════════════════
         CENTER-RIGHT — Player list (hidden when signage active)
         ══════════════════════════════════════════════════════ -->
    <Group id="playerColumn" translation="[640, 110]">
      <!-- Player count label -->
      <Label id="playerCountLabel" text="0 Players Ready" color="#ffffffCC"
             width="1240">
        <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="28" />
      </Label>

      <!-- Player grid container (dynamically populated with Avatar widgets) -->
      <Group id="playerGrid" translation="[0, 48]" />
    </Group>

    <!-- ══════════════════════════════════════════════════════
         RIGHT HALF — Signage panel (visible when signage active)
         ══════════════════════════════════════════════════════ -->
    <SignagePanel id="signagePanel" translation="[960, 0]" visible="false" />

  </children>

  <script type="text/brightscript" uri="pkg:/components/utils/FontFix.brs" />
  <script type="text/brightscript" uri="pkg:/components/utils/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/utils/Colors.brs" />
  <script type="text/brightscript" uri="LobbyScreen.brs" />
</component>
