<?xml version="1.0" encoding="utf-8" ?>
<component name="BetweenHypeScreen" extends="Group">
  <interface>
    <field id="barCode" type="string" />
    <field id="barName" type="string" />
    <field id="betweenData" type="assocarray" onChange="onDataChanged" />
    <field id="nextGameEpoch" type="longinteger" value="0" onChange="onEpochChanged" />
  </interface>

  <children>
    <!-- Background gradient -->
    <Poster id="bgGradient" width="1920" height="1080"
            uri="pkg:/images/bg-gradient.png" />

    <!-- Countdown bar overlay -->
    <CountdownBar id="countdownBar" />

    <!-- ═══ CENTERED LAYOUT ═══ -->
    <Group id="centerContent" translation="[0, 100]">

      <!-- Logo (hero size) -->
      <Logo id="logo" translation="[760, 30]" />

      <!-- "Next round starting soon!" heading -->
      <Label id="headingLabel" text="Next round starting soon!"
             translation="[0, 160]" width="1920" horizAlign="center" color="#f0f0f0">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="42" />
      </Label>

      <!-- Categories heading -->
      <Label id="categoriesLabel" text="COMING UP NEXT"
             translation="[0, 225]" width="1920" horizAlign="center" color="#ffffff80">
        <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="22" />
      </Label>

      <!-- Category pills (dynamically created) -->
      <Group id="pillContainer" translation="[0, 270]" />

      <!-- Big QR code — horizontal layout -->
      <Group id="qrArea" translation="[520, 520]">
        <Poster id="qrBig" uri="pkg:/images/qr-play-360.png"
                width="240" height="240" translation="[0, 0]" />
        <!-- Right: SCAN TO JOIN + code + URL -->
        <Label text="SCAN TO JOIN" translation="[280, 40]" width="400" color="#ffffff60">
          <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="20" />
        </Label>
        <Label id="bigCodeLabel" text="" translation="[280, 70]" color="#ffd200">
          <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="52" />
        </Label>
        <Label id="urlLabel" text="app.taptrivia.tv"
               translation="[280, 135]" width="400" color="#ffffff80">
          <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="22" />
        </Label>
      </Group>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/components/utils/FontFix.brs" />
  <script type="text/brightscript" uri="pkg:/components/utils/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/utils/Colors.brs" />
  <script type="text/brightscript" uri="BetweenHypeScreen.brs" />
</component>
