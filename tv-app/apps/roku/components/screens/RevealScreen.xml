<?xml version="1.0" encoding="utf-8" ?>
<component name="RevealScreen" extends="Group">
  <interface>
    <field id="barCode" type="string" />
    <field id="barName" type="string" />
    <field id="gameState" type="assocarray" onChange="onGameStateChanged" />
  </interface>

  <children>
    <!-- Background gradient -->
    <Poster id="bgGradient" width="1920" height="1080"
            uri="pkg:/images/bg-gradient.png" />

    <!-- ═══ HEADER (matches PlayingScreen positioning) ═══ -->
    <Group id="header" translation="[0, 0]">
      <!-- Header gradient overlay -->
      <Poster id="headerFade" uri="pkg:/images/header-fade.png" width="1920" height="120" />

      <!-- Left: TapTrivia logo + bar name -->
      <Group id="headerLeft" translation="[56, 20]">
        <Logo id="logo" />
        <Label id="headerBarName" text="" color="#f0f0f0"
               translation="[0, 38]">
          <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="36" />
        </Label>
      </Group>

      <!-- Center: "Answer Revealed" -->
      <Group id="headerCenter" translation="[960, 10]">
        <Label id="revealLabel" text="Answer Revealed" color="#00d4aa"
               width="400" horizAlign="center"
               translation="[-200, 12]">
          <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="40" />
        </Label>
      </Group>

      <!-- Right: Players badge + Timer at 0 -->
      <Group id="headerRight" translation="[1660, 12]">
        <!-- Players badge -->
        <Group id="playersBadge" translation="[0, 16]">
          <Label id="playersBadgeIcon" text="#" color="#ffffff60" >
            <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="24" />
          </Label>
          <Label id="playersBadgeCount" text="0" translation="[32, 2]" color="#f0f0f0">
            <Font role="font" uri="pkg:/fonts/Outfit-Bold.ttf" size="22" />
          </Label>
        </Group>
        <!-- Timer ring placeholder (static at 0) -->
        <Group id="timerGroup" translation="[100, 0]">
          <Poster id="timerRing" width="64" height="64"
                  uri="pkg:/images/timer-ring-danger-0.png" />
          <Label id="timerNum" text="0" translation="[0, 16]"
                 horizAlign="center" width="64" color="#ff4757">
            <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="24" />
          </Label>
        </Group>
      </Group>
    </Group>

    <!-- ═══ BODY ═══ (matches PlayingScreen layout to prevent jumping) -->
    <Group id="body" translation="[72, 152]">

      <!-- Left column: Question -->
      <Group id="questionCol" translation="[0, 35]">
        <!-- Category pill + Q counter -->
        <Group id="catRow" translation="[0, 0]">
          <Poster id="catPillBg" uri="pkg:/images/category-pill.png" width="240" height="40" />
          <Poster id="catIcon" uri="pkg:/images/cat-sm-default.png"
                  translation="[6, 2]" width="36" height="36" />
          <Label id="catName" text="" translation="[46, 4]" color="#ffffffB0" width="450">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="28" />
          </Label>
          <Group id="qCounter" translation="[260, 0]">
            <Label id="qNum" text="Q1" color="#ffd200">
              <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="28" />
            </Label>
            <Label id="qSep" text="/15" color="#ffffff40"
                   translation="[40, 0]">
              <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="28" />
            </Label>
          </Group>
        </Group>

        <!-- Question text -->
        <Label id="questionText" text=""
               translation="[0, 60]" width="960" color="#f0f0f0"
               wrap="true" maxLines="5" lineSpacing="-12">
          <Font role="font" uri="pkg:/fonts/Outfit-ExtraBold.ttf" size="60" />
        </Label>

        <!-- Progress bar -->
        <Group id="progressBar" translation="[0, 500]">
          <Poster id="progressBg" uri="pkg:/images/progress-bar-track.png" width="900" height="6" />
          <Rectangle id="progressFill" color="#667eea" width="450" height="6" />
        </Group>
      </Group>

      <!-- Right column: Answer cards (vertical stack, fill available space) -->
      <Group id="answersCol" translation="[988, 40]">
        <AnswerCard id="card0" translation="[0, 0]" />
        <AnswerCard id="card1" translation="[0, 160]" />
        <AnswerCard id="card2" translation="[0, 320]" />
        <AnswerCard id="card3" translation="[0, 480]" />
      </Group>
    </Group>

    <!-- ═══ FOOTER — bottom bar with top 5 player strip ═══ -->
    <Group id="footer" translation="[0, 960]">
      <Poster id="footerFade" uri="pkg:/images/footer-fade.png" width="1920" height="120" />

      <Group id="footerScores" translation="[0, 16]">
        <Group id="footerPlayer0" visible="false">
          <Avatar id="fpAvatar0" translation="[0, 0]" />
          <Label id="fpName0" text="" translation="[0, 44]" horizAlign="center" width="80" maxLines="1"
                 color="#f0f0f0">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="16" />
          </Label>
          <Label id="fpScore0" text="" translation="[0, 62]" horizAlign="center" width="80"
                 color="#ffd200">
            <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="16" />
          </Label>
        </Group>
        <Group id="footerPlayer1" visible="false">
          <Avatar id="fpAvatar1" translation="[0, 0]" />
          <Label id="fpName1" text="" translation="[0, 44]" horizAlign="center" width="80" maxLines="1"
                 color="#f0f0f0">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="16" />
          </Label>
          <Label id="fpScore1" text="" translation="[0, 62]" horizAlign="center" width="80"
                 color="#ffd200">
            <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="16" />
          </Label>
        </Group>
        <Group id="footerPlayer2" visible="false">
          <Avatar id="fpAvatar2" translation="[0, 0]" />
          <Label id="fpName2" text="" translation="[0, 44]" horizAlign="center" width="80" maxLines="1"
                 color="#f0f0f0">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="16" />
          </Label>
          <Label id="fpScore2" text="" translation="[0, 62]" horizAlign="center" width="80"
                 color="#ffd200">
            <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="16" />
          </Label>
        </Group>
        <Group id="footerPlayer3" visible="false">
          <Avatar id="fpAvatar3" translation="[0, 0]" />
          <Label id="fpName3" text="" translation="[0, 44]" horizAlign="center" width="80" maxLines="1"
                 color="#f0f0f0">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="16" />
          </Label>
          <Label id="fpScore3" text="" translation="[0, 62]" horizAlign="center" width="80"
                 color="#ffd200">
            <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="16" />
          </Label>
        </Group>
        <Group id="footerPlayer4" visible="false">
          <Avatar id="fpAvatar4" translation="[0, 0]" />
          <Label id="fpName4" text="" translation="[0, 44]" horizAlign="center" width="80" maxLines="1"
                 color="#f0f0f0">
            <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="16" />
          </Label>
          <Label id="fpScore4" text="" translation="[0, 62]" horizAlign="center" width="80"
                 color="#ffd200">
            <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="16" />
          </Label>
        </Group>
      </Group>
    </Group>

    <!-- QR Badge (bottom-left) -->
    <QRBadge id="qrBadge" translation="[40, 920]" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/utils/FontFix.brs" />
  <script type="text/brightscript" uri="pkg:/components/utils/Utils.brs" />
  <script type="text/brightscript" uri="pkg:/components/utils/Colors.brs" />
  <script type="text/brightscript" uri="RevealScreen.brs" />
</component>
