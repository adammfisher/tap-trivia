<?xml version="1.0" encoding="utf-8" ?>
<component name="TapTriviaScene" extends="Scene">
  <interface>
    <field id="currentScreen" type="string" value="" />
    <field id="tvDeviceId" type="string" value="" />
    <function name="makeApiCall" />
  </interface>

  <children>
    <!-- Animated background gradient (video plane behind UI). Doubles as
         media-activity keepalive — Roku OS counts active video playback
         toward "channel activity" and defers the inactivity auto-home. -->
    <Video id="bgVideo" width="1920" height="1080" visible="true" enableUI="false" />

    <!-- Dim overlay to tone down the video plane (it renders brighter than
         the source colors on Roku Express). 50% black brings it back into
         the "dark cocktail lounge" range. -->
    <Rectangle id="bgDim" width="1920" height="1080" color="#000000" opacity="0.5" />

    <!-- Screen container — all screens layered here, toggle visibility -->
    <Group id="screenContainer">
      <SetupScreen id="setupScreen" visible="false" />
      <IdleScreen id="idleScreen" visible="false" />
      <LobbyScreen id="lobbyScreen" visible="false" />
      <GetReadyScreen id="getReadyScreen" visible="false" />
      <CategoryScreen id="categoryScreen" visible="false" />
      <PlayingScreen id="playingScreen" visible="false" />
      <RevealScreen id="revealScreen" visible="false" />
      <LeaderboardScreen id="leaderboardScreen" visible="false" />
      <BetweenScreen id="betweenScreen" visible="false" />
      <ResultsScreen id="resultsScreen" visible="false" />
      <BetweenPodiumScreen id="betweenPodiumScreen" visible="false" />
      <BetweenStandingsScreen id="betweenStandingsScreen" visible="false" />
      <BetweenNationalScreen id="betweenNationalScreen" visible="false" />
      <BetweenHypeScreen id="betweenHypeScreen" visible="false" />
    </Group>

    <!-- Error overlay (hidden by default) -->
    <Group id="errorOverlay" visible="false">
      <Rectangle color="#08080cCC" width="1920" height="1080" />
      <Group translation="[760, 440]">
        <Rectangle color="#1a1a2eEE" width="400" height="200" />
        <Label text="Reconnecting..."
               translation="[200, 60]"
               horizAlign="center" vertAlign="center"
               width="400"
               color="#ffd200">
          <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="32" />
        </Label>
        <Label text="Check your internet connection"
               translation="[200, 110]"
               horizAlign="center" vertAlign="center"
               width="400"
               color="#ffffff80">
          <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
        </Label>
      </Group>
    </Group>

    <!-- API polling task -->
    <ApiTask id="apiTask" />

    <!-- Separate API task for between-game data (avoids race with poll timer) -->
    <ApiTask id="betweenApiTask" />

    <!-- Separate API task for /tv-heartbeat so it can't be starved by polling -->
    <ApiTask id="heartbeatApiTask" />

    <!-- Heartbeat timer — fires every 5 min while paired -->
    <Timer id="heartbeatTimer" duration="300" repeat="true" />

    <!-- Screensaver prevention: ECP self-ping task -->
    <KeepAwakeTask id="keepAwakeTask" />
  </children>

  <script type="text/brightscript" uri="TapTriviaScene.brs" />
</component>
