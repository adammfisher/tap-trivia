<?xml version="1.0" encoding="utf-8" ?>
<component name="TapTriviaScene" extends="Scene">
  <interface>
    <field id="currentScreen" type="string" value="" />
    <field id="tvDeviceId" type="string" value="" />
    <function name="makeApiCall" />
  </interface>

  <children>
    <!-- Fallback base color — always visible, prevents black flash if video gaps -->
    <Rectangle id="bgBase" width="1920" height="1080" color="#0f0326" />

    <!-- Ghost keepalive video — 2x2 silent black MP4, bundled locally (pkg://).
         Loops off-screen at near-zero opacity. Roku OS sees active video
         playback and blocks the screensaver. disableScreenSaver=true is the
         explicit documented API for this purpose.
         IMPORTANT: this does NOT prevent Roku Bandwidth Saver (4-hr no-remote
         kill). Disable that in device settings: Settings→Network→Bandwidth
         Saver→Off and Settings→System→Power→Auto Power Savings→Off. -->
    <Video id="bgVideo"
           width="2" height="2"
           translation="[-10, -10]"
           opacity="0.01"
           visible="true"
           enableUI="false"
           disableScreenSaver="true" />

    <!-- Static gradient covers the video plane — no flash on loop restart -->
    <Poster id="bgStatic" width="1920" height="1080" uri="pkg:/images/bg-gradient.png" />

    <!-- Dim overlay -->
    <Rectangle id="bgDim" width="1920" height="1080" color="#000000" opacity="0.2" />

    <!-- Screen container — all screens layered here, toggle visibility -->
    <Group id="screenContainer">
      <SetupScreen id="setupScreen" visible="false" />
      <IdleScreen id="idleScreen" visible="false" />
      <LobbyScreen id="lobbyScreen" visible="false" />
      <GetReadyScreen id="getReadyScreen" visible="false" />
      <CategoryScreen id="categoryScreen" visible="false" />
      <PlayingScreen id="playingScreen" visible="false" />
      <RevealScreen id="revealScreen" visible="false" />
      <LeaderboardScreen id="leaderboardScreen" visible="false" />
      <BetweenScreen id="betweenScreen" visible="false" />
      <ResultsScreen id="resultsScreen" visible="false" />
      <BetweenPodiumScreen id="betweenPodiumScreen" visible="false" />
      <BetweenStandingsScreen id="betweenStandingsScreen" visible="false" />
      <BetweenNationalScreen id="betweenNationalScreen" visible="false" />
      <BetweenHypeScreen id="betweenHypeScreen" visible="false" />
      <PlayTapTriviaScreen id="playTapTriviaScreen" visible="false" />
      <ComingUpScreen id="comingUpScreen" visible="false" />
      <LeaderResultsScreen id="leaderResultsScreen" visible="false" />
    </Group>

    <!-- Persistent next-game countdown pill — a "notch" hanging from the top
         center edge, overlays every screen. Toggled/updated in TapTriviaScene.brs
         (updateNextPill). Sits above all screens, below the error overlay. -->
    <Group id="nextPill" translation="[650, 0]" visible="false">
      <Poster uri="pkg:/images/next-pill-bg.png" width="620" height="96" />
      <Poster uri="pkg:/images/next-pill-dot.png" width="34" height="34" translation="[118, 31]" />
      <Label id="nextPillLabel" text="TRIVIA STARTS IN" translation="[166, 0]"
             width="320" height="96" vertAlign="center" color="#ffffffA6">
        <Font role="font" uri="pkg:/fonts/DMMono-Regular.ttf" size="24" />
      </Label>
      <Label id="nextPillTime" text="0:00" translation="[420, 0]"
             width="150" height="96" vertAlign="center" color="#ffd200">
        <Font role="font" uri="pkg:/fonts/Fredoka-Bold.ttf" size="40" />
      </Label>
    </Group>

    <!-- Error overlay (hidden by default) -->
    <Group id="errorOverlay" visible="false">
      <Rectangle color="#08080cCC" width="1920" height="1080" />
      <Group translation="[760, 440]">
        <Rectangle color="#1a1a2eEE" width="400" height="200" />
        <Label text="Reconnecting..."
               translation="[200, 60]"
               horizAlign="center" vertAlign="center"
               width="400"
               color="#ffd200">
          <Font role="font" uri="pkg:/fonts/Outfit-SemiBold.ttf" size="32" />
        </Label>
        <Label text="Check your internet connection"
               translation="[200, 110]"
               horizAlign="center" vertAlign="center"
               width="400"
               color="#ffffff80">
          <Font role="font" uri="pkg:/fonts/Outfit-Regular.ttf" size="22" />
        </Label>
      </Group>
    </Group>

    <!-- API polling task -->
    <ApiTask id="apiTask" />

    <!-- Separate API task for between-game data (avoids race with poll timer) -->
    <ApiTask id="betweenApiTask" />

    <!-- Separate API task for /tv-heartbeat so it can't be starved by polling -->
    <ApiTask id="heartbeatApiTask" />

    <!-- Heartbeat timer — fires every 5 min while paired -->
    <Timer id="heartbeatTimer" duration="300" repeat="true" />

    <!-- Screensaver prevention: ECP self-ping task -->
    <KeepAwakeTask id="keepAwakeTask" />
  </children>

  <script type="text/brightscript" uri="TapTriviaScene.brs" />
</component>
