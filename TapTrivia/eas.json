{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "test": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "dev"
      }
    },
    "test-device": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "dev"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "adam.fisher@visudolabs.com",
        "ascAppId": "6762301564",
        "appleTeamId": "NCJ5B632NP",
        "ascApiKeyPath": "/Users/adamfisher/Desktop/secrets/AuthKey_EAS_REPLACE.p8",
        "ascApiKeyId": "REPLACE_KEY_ID",
        "ascApiKeyIssuerId": "REPLACE_ISSUER_UUID"
      },
      "android": {
        "serviceAccountKeyPath": "/Users/adamfisher/Desktop/secrets/play-eas-submit.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
